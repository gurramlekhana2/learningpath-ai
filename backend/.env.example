# LearningPath AI - Backend Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:9000","http://127.0.0.1:9000","http://localhost:9001","http://127.0.0.1:9001","http://localhost:5173","http://127.0.0.1:5173"]

# Security & JWT
JWT_SECRET_KEY=learningpath_ai_super_secret_jwt_key_2026_dev_sec_9999
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Uses MongoDB if running; gracefully falls back to persistent local DocumentDB store if not
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=learningpath_ai

# Firecrawl API (https://firecrawl.dev)
# Set your Firecrawl API key here. If left empty, intelligent verified live cache/adapter mode is activated.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# Memento AI Memory Integration (https://github.com/shane-farkas/memento-memory & Mem0 compatible)
# Supports bitemporal knowledge graph persistence, valid time tracking & Mem0 API adapter
MEMENTO_API_KEY=
MEMENTO_API_URL=https://api.mem0.ai/v1
MEMENTO_STORAGE_MODE=bitemporal_hybrid  # Options: bitemporal_hybrid, mem0_cloud, local_isolated

# LLM Reasoning Engine (OpenAI / Gemini / Anthropic / Local API)
# Set your API key for direct cloud LLM inference. If left empty, local reasoning engine with domain intelligence is active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
LLM_PROVIDER=auto  # Options: auto, openai, gemini, local_engine

# Demonstration Mode & Seed Data
DEMO_MODE=true
